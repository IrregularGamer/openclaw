+def owner542_read(deadline_ns):
+    """Read the existing native predicate, without Controller construction or state I/O.
+
+    Prepared source only. This is not a supported gateway transport or a quota
+    attestation. An authenticated, cancellable native transport is still required.
+    """
+    import signal
+    from types import SimpleNamespace
+
+    entered = time.monotonic_ns()
+    if (type(deadline_ns) is not int or deadline_ns <= entered
+            or deadline_ns - entered > 10_000_000_000):
+        raise PermissionError('owner542_deadline')
+
+    def check():
+        if time.monotonic_ns() >= deadline_ns:
+            raise PermissionError('owner542_deadline')
+
+    def cancelled(signum, frame):
+        raise PermissionError('owner542_cancelled')
+
+    command = ['systemctl', '--user', '--machine=deploy@.host', 'show',
+               'openclaw-gateway.service', '-p', 'MainPID', '--value']
+
+    def runner(argv, *, capture_output, text, timeout):
+        check()
+        if argv != command or capture_output is not True or text is not True:
+            raise PermissionError('owner542_command')
+        # subprocess.run kills AND waits for its child on timeout or any exception,
+        # including the cancellation signal raised above. No shell or background task.
+        result = subprocess.run(argv, capture_output=True, text=True,
+                                timeout=min(timeout, (deadline_ns-time.monotonic_ns())/1e9))
+        check()
+        return result
+
+    previous = {}
+    try:
+        for sig in (signal.SIGTERM, signal.SIGINT):
+            previous[sig] = signal.signal(sig, cancelled)
+        if os.geteuid() != 0:
+            raise PermissionError('owner542_root')
+        result = runner(command, capture_output=True, text=True, timeout=5)
+        value = result.stdout.strip()
+        if result.returncode or not value.isascii() or not value.isdecimal() or int(value) < 1:
+            raise PermissionError('owner542_gateway')
+        pid = int(value)
+        start = (Path('/proc')/str(pid)/'stat').read_text().rsplit(')', 1)[1].split()[19]
+        owner = {'name':'Pinch', 'session':HQ510, 'pid':pid, 'start':start}
+        native = Native510(SimpleNamespace(root=ROOT, runner=runner))
+        check()
+        native.owner_check(owner, caller=True)
+        check()
+        native.owner_check(owner, caller=True)
+        check()
+        return {'schemaVersion':1, 'owner':owner}
+    finally:
+        for sig, handler in previous.items():
+            signal.signal(sig, handler)
